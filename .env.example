# ─────────────────────────────────────────────────────────────────────────────
# Zova Infotech website — environment variables
# Copy to `.env.local` for local development. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public (VITE_*) — these ARE embedded in the browser bundle. No secrets here.
# Production origin. Leave empty until the domain/deployment is confirmed.
# When set: canonical URLs, og:url and sitemap.xml are generated.
VITE_SITE_URL=

# Contact details — optional overrides of the defaults in src/config/site.ts
# (phone +91 74608 54541, Zovainfotech@gmail.com, WhatsApp 917460854541)
VITE_CONTACT_PHONE=
VITE_CONTACT_PHONE_E164=
VITE_CONTACT_EMAIL=
# Verified WhatsApp Business number, international format digits only (e.g. 9198XXXXXXXX)
VITE_WHATSAPP_NUMBER=

# Where forms POST to. Leave EMPTY in production — defaults to the bundled /api/enquiry function.
# Set to `off` only for static previews without a server (forms then run in labelled demo mode).
VITE_ENQUIRY_ENDPOINT=

# ── Server-only Email / Mailer Settings — used by api/enquiry.ts & api/mailer.ts
# Choose ANY of the following free options:

# OPTION 1: Free Gmail SMTP (500 emails/day free to any recipient, no custom domain required)
# 1. Go to Google Account → Security → 2-Step Verification
# 2. At bottom, select "App passwords", name it "Zova Website", copy the 16-character password
# GMAIL_USER=zovainfotech@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# OPTION 2: Free Brevo (Sendinblue) API (300 emails/day free to any recipient)
# Sign up at https://brevo.com and get your API key from SMTP & API
# BREVO_API_KEY=xkeysib-...
# BREVO_FROM_EMAIL=zovainfotech@gmail.com

# OPTION 3: Resend API (3,000 emails/month free)
# Sign up at https://resend.com
RESEND_API_KEY=

# Send customer confirmation copy to the user email entered in the form (default: true)
SEND_USER_CONFIRMATION=true

# Destination business inbox (default: zovainfotech@gmail.com). Comma-separate for several.
ENQUIRY_TO_EMAIL=zovainfotech@gmail.com

# Sender name / address
ENQUIRY_FROM_EMAIL="ZOVA INFOTECH Website <onboarding@resend.dev>"

# Optional backup log (Google Sheets Apps Script in docs/enquiry-log.gs)
ENQUIRY_LOG_WEBHOOK_URL=
ENQUIRY_LOG_TOKEN=
# Optional CRM / Zapier / Make webhook (HMAC-signed with CRM_WEBHOOK_SECRET)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
ALLOWED_ORIGINS=
